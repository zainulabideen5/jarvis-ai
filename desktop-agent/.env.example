# Server connection
JARVIS_SERVER_WS_URL=ws://localhost:8000/ws/agent
JARVIS_SERVER_API_URL=http://localhost:8000/api

# Gmail driver (get app password from Google Account > Security > App passwords)
JARVIS_GMAIL_ADDRESS=
JARVIS_GMAIL_APP_PASSWORD=

# Telegram driver (get from @BotFather)
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_CHAT_ID=

# Slack driver (create app at api.slack.com/apps)
JARVIS_SLACK_WEBHOOK_URL=
JARVIS_SLACK_BOT_TOKEN=
JARVIS_SLACK_DEFAULT_CHANNEL=

# Discord driver (Server Settings > Integrations > Webhooks)
JARVIS_DISCORD_WEBHOOK_URL=

# Notion driver (create integration at notion.so/my-integrations)
JARVIS_NOTION_TOKEN=
JARVIS_NOTION_DATABASE_ID=

# Groq API (for vision driver - https://console.groq.com)
JARVIS_GROQ_API_KEY=

# General
JARVIS_LOG_LEVEL=INFO
