# Jarvis Server Environment Variables

# Groq API Key (required for task extraction)
# Get one from https://console.groq.com
JARVIS_GROQ_API_KEY=your_groq_api_key_here

# Whisper model: tiny, base, small, medium, large-v3
JARVIS_WHISPER_MODEL=base

# Speaker diarization (optional)
# Get HF token from https://huggingface.co/settings/tokens
# Accept model terms at https://huggingface.co/pyannote/speaker-diarization-3.1
JARVIS_DIARIZATION_ENABLED=false
JARVIS_HF_TOKEN=

# Log level
JARVIS_LOG_LEVEL=INFO
